# Optional: a server-side CryptoDataApi key used as a fallback when the
# browser has not supplied its own key (e.g. for a hosted public demo).
# Every visitor without their own key will spend this key's rate limit.
# CDA_DEMO_KEY=

# Optional: override the upstream API base URL (defaults to production).
# CDA_API_BASE=https://cryptodataapi.com/api/v1
