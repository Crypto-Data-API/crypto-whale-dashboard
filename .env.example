# Server-side CryptoDataApi key. Used by the /api/cda proxies whenever the
# browser has not supplied its own key in Settings. It is never sent to the
# browser and is used for read-only (GET) requests only.
# On a public deployment every visitor without their own key spends this
# key's rate limit, so leave it empty there unless that is intended.
CDA_API_KEY=

# Optional: override the upstream API base URL (defaults to production).
# CDA_API_BASE=https://cryptodataapi.com/api/v1
